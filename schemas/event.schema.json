{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/daily-sound-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "label", "confidence", "started_at", "ended_at", "duration_ms", "source", "model", "decision"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "pattern": "^evt_"},
    "label": {"enum": ["cough", "sneeze", "laughter", "alarm", "timer_or_ringtone"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "source": {"const": "microphone"},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["architecture", "checkpoint", "classifier_version"],
      "properties": {"architecture": {"type": "string"}, "checkpoint": {"type": "string"}, "classifier_version": {"type": "string"}}
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["start_threshold", "peak_score", "frames_above_threshold"],
      "properties": {"start_threshold": {"type": "number"}, "peak_score": {"type": "number"}, "frames_above_threshold": {"type": "integer", "minimum": 0}}
    }
  }
}

